<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Aula de Enfermería</title>

    <link rel="stylesheet" href="css/estilos.css">
</head>

<body>

<header class="header">

    <div class="logo">
        🩺 <span>Aula de Enfermería</span>
    </div>

    <nav>
        <a href="#inicio">Inicio</a>
        <a href="#cursos">Cursos</a>
        <a href="#herramientas">Herramientas</a>
        <a href="#recursos">Recursos</a>
        <a href="login.html" class="btn-login">Iniciar sesión</a>
    </nav>

</header>


<main>

<section id="inicio" class="hero">

    <div class="hero-text">

        <span class="badge">
            Plataforma educativa de enfermería
        </span>

        <h1>
            Aprende enfermería de una manera
            <span>interactiva</span>
        </h1>

        <p>
            Cursos, casos clínicos, calculadoras, escalas de
            valoración, recursos de consulta y evaluaciones
            diseñadas para estudiantes de enfermería.
        </p>

        <div class="hero-buttons">

            <a href="registro.html" class="btn-primary">
                Crear mi cuenta
            </a>

            <a href="#cursos" class="btn-secondary">
                Explorar cursos
            </a>

        </div>

    </div>


    <div class="hero-card">

        <div class="medical-icon">
            🩺
        </div>

        <h2>
            Aula de Enfermería
        </h2>

        <p>
            Un espacio para aprender,
            practicar y evaluar tus
            conocimientos.
        </p>

    </div>

</section>



<section id="cursos" class="section">

    <div class="section-title">

        <span>FORMACIÓN</span>

        <h2>
            Cursos de enfermería
        </h2>

        <p>
            Accede a contenidos organizados por asignatura.
        </p>

    </div>


    <div class="cards">


        <article class="course-card">

            <div class="course-icon">
                🩺
            </div>

            <h3>
                Fundamentos de Enfermería
            </h3>

            <p>
                Procedimientos básicos, expediente clínico,
                signos vitales, posiciones y cuidados.
            </p>

            <button onclick="requiereAcceso()">
                Ver curso
            </button>

        </article>



        <article class="course-card">

            <div class="course-icon">
                🏥
            </div>

            <h3>
                Enfermería Médico-Quirúrgica
            </h3>

            <p>
                Valoración, cuidados y atención integral
                del paciente adulto.
            </p>

            <button onclick="requiereAcceso()">
                Ver curso
            </button>

        </article>



        <article class="course-card">

            <div class="course-icon">
                🫁
            </div>

            <h3>
                Enfermería en UCI
            </h3>

            <p>
                Cuidados del paciente crítico,
                ventilación mecánica y monitorización.
            </p>

            <button onclick="requiereAcceso()">
                Ver curso
            </button>

        </article>



        <article class="course-card">

            <div class="course-icon">
                📋
            </div>

            <h3>
                Proceso Enfermero
            </h3>

            <p>
                Valoración, diagnóstico, planeación,
                intervención y evaluación.
            </p>

            <button onclick="requiereAcceso()">
                Ver curso
            </button>

        </article>

    </div>

</section>



<section id="herramientas" class="section tools-section">

    <div class="section-title">

        <span>HERRAMIENTAS</span>

        <h2>
            Centro de herramientas
        </h2>

    </div>


    <div class="tools-grid">


        <div class="tool">

            <span>🧮</span>

            <h3>
                Calculadoras clínicas
            </h3>

            <p>
                IMC, PAM, goteo, infusión,
                dosis y conversiones.
            </p>

        </div>



        <div class="tool">

            <span>📊</span>

            <h3>
                Escalas de valoración
            </h3>

            <p>
                Glasgow, Braden, Morse,
                Barthel y otras.
            </p>

        </div>



        <div class="tool">

            <span>🩺</span>

            <h3>
                Casos clínicos
            </h3>

            <p>
                Situaciones clínicas
                para desarrollar razonamiento.
            </p>

        </div>



        <div class="tool">

            <span>📝</span>

            <h3>
                Evaluaciones
            </h3>

            <p>
                Preguntas, cuestionarios
                y autoevaluaciones.
            </p>

        </div>



        <div class="tool">

            <span>📚</span>

            <h3>
                Biblioteca
            </h3>

            <p>
                Materiales y recursos
                para consulta.
            </p>

        </div>



        <div class="tool">

            <span>🧠</span>

            <h3>
                Flashcards
            </h3>

            <p>
                Repasa conceptos importantes
                de enfermería.
            </p>

        </div>

    </div>

</section>



<section id="recursos" class="section resources">

    <div class="section-title">

        <span>RECURSOS</span>

        <h2>
            Aprende practicando
        </h2>

    </div>


    <div class="resource-box">

        <div>

            <h2>
                Material diseñado para estudiantes de enfermería
            </h2>

            <p>
                La plataforma podrá integrar posteriormente
                tus presentaciones, documentos, casos clínicos,
                actividades y materiales de cada asignatura.
            </p>

        </div>


        <a href="registro.html" class="btn-primary">
            Registrarme
        </a>

    </div>

</section>

</main>



<footer>

    <p>
        © 2026 Aula de Enfermería
    </p>

    <p>
        Plataforma educativa para estudiantes de enfermería
    </p>

</footer>


<script src="js/app.js"></script>

</body>
</html>